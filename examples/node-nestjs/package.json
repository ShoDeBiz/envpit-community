{
  "name": "envpit-example-node-nestjs",
  "private": true,
  "description": "NestJS app that loads config from EnvPit (via the PUBLISHED @envpit/sdk) into process.env before @nestjs/config's ConfigModule reads the environment.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js"
  },
  "dependencies": {
    "@envpit/sdk": "^0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
